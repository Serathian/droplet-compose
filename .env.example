# Your GitHub username (used to pull images from GHCR)
GITHUB_OWNER=Serathian

# Email for Let's Encrypt certificate registration
ACME_EMAIL=your@email.com

# Traefik dashboard basic auth (generate with: docker run --rm httpd:alpine htpasswd -nB admin | sed -e 's/\$/\$\$/g')
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changeme

# Secret token for triggering Watchtower webhooks (generate with: openssl rand -hex 32)
WATCHTOWER_TOKEN=change-me-to-a-secure-random-hex-string

# ---------------------------------------------------
# Houseforce (Strapi CMS)
# ---------------------------------------------------
# HOUSEFORCE_NEXT_PUBLIC_STRAPI_URL=https://houseforce-cms.jake-reddy.com
# HOUSEFORCE_STRAPI_APP_KEYS=change-me
# HOUSEFORCE_STRAPI_API_TOKEN_SALT=change-me
# HOUSEFORCE_STRAPI_ADMIN_JWT_SECRET=change-me
# HOUSEFORCE_STRAPI_TRANSFER_TOKEN_SALT=change-me
# HOUSEFORCE_STRAPI_JWT_SECRET=change-me
# HOUSEFORCE_DB_NAME=strapi
# HOUSEFORCE_DB_USER=strapi
# HOUSEFORCE_DB_PASSWORD=change-me

# ---------------------------------------------------
# Basecamp (Payload CMS + PostgreSQL)
# ---------------------------------------------------
# BASECAMP_PAYLOAD_SECRET=change-me
# BASECAMP_DB_NAME=payload
# BASECAMP_DB_USER=payload
# BASECAMP_DB_PASSWORD=change-me

# Legacy MySQL / WordPress credentials (services removed; kept until WP content is migrated)
# MYSQL_ROOT_PASSWORD=change-me-strong-root-password
# MYSQL_DATABASE=wordpress
# MYSQL_USER=wordpress
# MYSQL_PASSWORD=change-me-strong-password

# jake-reddy.com backend env vars
# SMTP credentials for nodemailer (contact form)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
CONTACT_TO_EMAIL=your@email.com
# reCAPTCHA secret key
RECAPTCHA_SECRET=your-recaptcha-secret
