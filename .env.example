# GitHub Configuration (used to pull images from GHCR)
GITHUB_OWNER=Serathian

# Email for Let's Encrypt certificate registration (Traefik TLS)
ACME_EMAIL=your@email.com

# Traefik dashboard basic auth (generate with: docker run --rm httpd:alpine htpasswd -nB admin | sed -e 's/\$/\$\$/g')
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changeme

# PostgreSQL + PostGIS credentials (CMS database)
POSTGRES_DB=payload
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me-strong-password

# Basecamp CMS Payload secret
PAYLOAD_SECRET=change-me-strong-random-payload-secret

# Watchtower webhook token (used by GitHub Actions to trigger instant deployments)
WATCHTOWER_TOKEN=change-me-strong-random-watchtower-token

# Frontend & API endpoints
CMS_API_INTERNAL=http://basecamp:3000/api
NEXT_PUBLIC_CMS_URL=https://basecamp.jake-reddy.com
